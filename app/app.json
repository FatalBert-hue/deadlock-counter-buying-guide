{
  "expo": {
    "name": "DCB",
    "slug": "counter-buy",
    "version": "0.1.3",
    "description": "Counter-buy guide for Deadlock \u2014 pick the enemy hero and their items, get the counter-buy. Unofficial fan companion, not affiliated with Valve. Working title; final name to be decided.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "counter-buy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.counterbuy.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0a0c14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0c14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1b385310-07b3-4268-88b6-f870661af1a6"
      }
    },
    "owner": "stolas_m"
  }
}