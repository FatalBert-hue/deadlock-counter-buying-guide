{
  "expo": {
    "name": "DCB",
    "slug": "counter-buy",
    "version": "0.1.8",
    "description": "Counter-buy guide for Deadlock \u2014 pick the enemy hero and their items, get the counter-buy. Unofficial fan companion, not affiliated with Valve. Working title; final name to be decided.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "counter-buy",
      "dcb"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.counterbuy.app",
      "versionCode": 9,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0a0c14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/json",
              "pathPattern": ".*\\.json"
            },
            {
              "scheme": "file",
              "mimeType": "application/json",
              "pathPattern": ".*\\.json"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "dcb"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "fatalbert-hue.github.io",
              "pathPrefix": "/dcb/build"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0c14",
          "image": "./assets/images/splash.png",
          "imageWidth": 300,
          "resizeMode": "cover",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#0a0c14"
          },
          "android": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#0a0c14"
          },
          "ios": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#0a0c14"
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1b385310-07b3-4268-88b6-f870661af1a6"
      }
    },
    "owner": "stolas_m"
  }
}